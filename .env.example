APP_NAME="minimini.org"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minimini
DB_USERNAME=minimini
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@minimini.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Set a long random password before seeding. Never commit the real value.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@minimini.org
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE="+15555550100"
SUPER_ADMIN_COUNTRY="United States"

# Demo members are created only when this is true.
SEED_DEMO_DATA=false

# Comma-separated proxy IPs, or * when the app sits behind a trusted load balancer.
TRUSTED_PROXIES=

FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=
# Public URL Flutterwave should return the member to. Blank uses APP_URL/member/payments/callback.
FLW_REDIRECT_URL=
FLW_BASE_URL=https://api.flutterwave.com
